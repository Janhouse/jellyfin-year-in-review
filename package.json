{
	"name": "jellyfin-year-in-review",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun run next dev --turbopack",
		"build": "bun --bun run next build",
		"start": "bun --bun run  next start",
		"typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
		"lint": "bun --bun run biome check .",
		"lint:fix": "bun --bun run biome check --write .",
		"lint:ci": "biome ci .",
		"format": "bun --bun run biome format --write ."
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-progress": "^1.1.16",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"better-auth": "^1.7.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cron": "^4.4.0",
		"framer-motion": "^13.1.1",
		"js-confetti": "^0.13.1",
		"lucide-react": "^1.33.0",
		"next": "^16.3.3",
		"nodemailer": "^9.0.5",
		"postcss": "^8.5.26",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"@types/cron": "^2.4.3",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"typescript": "^7.0.2"
	}
}
